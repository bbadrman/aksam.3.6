{% extends 'admin/base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
    {% set actions %}
        {% if is_granted('PERM_CREER_PROSPECT') %}
            <a href="{{ path('app_traitement_new') }}" class="flex h-9 w-full items-center justify-center rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground transition-all duration-300 hover:scale-105 hover:bg-primary/90 hover:shadow-lg hover:shadow-primary/30 sm:w-auto">
                Nouveau prospect
            </a>
        {% endif %}
    {% endset %}
    {{ include('admin/_header.html.twig', {
        title: 'Tableau de bord',
        description: 'Vue d\'ensemble de l\'activité AksamCrm',
        actions: actions
    }) }}

    <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4 md:mt-5">
        {% set stats = [
            { title: 'Nouveaux prospects', value: nouveauxCount, href: path('app_traitement_nouveaux'), primary: true, permission: 'PERM_NOUVEAU_PROSPECT' },
            { title: 'Prospects non traités', value: nonTraitesCount, href: path('app_traitement_non_traites'), permission: 'PERM_PROSPECTS_NON_TRAITES' },
            { title: 'Relances du jour', value: relancesDuJourCount, href: path('app_traitement_relances_du_jour'), permission: 'PERM_RELANCES_DU_JOUR' },
            { title: 'Relances à venir', value: relancesAVenirCount, href: path('app_traitement_relances_a_venir'), permission: 'PERM_RELANCES_A_VENIR' },
            { title: 'Injoignables', value: injoignablesCount, href: path('app_traitement_injoignables'), permission: 'PERM_INJOIGNABLES' },
            { title: 'Relances non traitées', value: relancesNonTraiteesCount, href: path('app_traitement_relances_non_traitees'), amber: true, permission: 'PERM_RELANCES_NON_TRAITEES' },
            { title: 'Recherche prospects', value: prospectsTotalCount, href: path('app_traitement_recherche'), permission: 'PERM_RECHERCHE_PROSPECTS' },
            { title: 'Clients', value: clientsCount, href: path('app_client_index') },
            { title: 'Contrats', value: contratsCount, href: path('app_contrat_index') },
            { title: 'SAV ouverts', value: savOuvertsCount, href: path('app_sav_index'), amber: true, permission: 'PERM_SAV_OUVERTS' },
        ] %}
        {% set stats = stats|filter(stat => stat.permission is not defined or is_granted(stat.permission)) %}
        {% for stat in stats %}
            {% set isPrimary = stat.primary is defined and stat.primary %}
            {% set isAmber = stat.amber is defined and stat.amber %}
            <a href="{{ stat.href }}" class="animate-admin-slide-in-up rounded-2xl p-4 shadow-lg transition-all duration-500 ease-out hover:scale-105 hover:shadow-2xl {{ isPrimary ? 'bg-primary text-primary-foreground' : 'bg-card text-foreground' }}">
                <div class="mb-3 flex items-start justify-between">
                    <h3 class="text-xs font-medium opacity-90">{{ stat.title }}</h3>
                    <div class="flex h-6 w-6 items-center justify-center rounded-full {{ isPrimary ? 'bg-primary-foreground/20' : 'bg-primary' }}">
                        {{ include('admin/_icon.html.twig', { name: 'arrow-up-right', class: 'h-3 w-3 text-primary-foreground' }) }}
                    </div>
                </div>
                <p class="mb-2 text-3xl font-bold {{ isAmber ? 'text-amber-600' : '' }}">{{ stat.value }}</p>
            </a>
        {% endfor %}
    </div>
{% endblock %}
