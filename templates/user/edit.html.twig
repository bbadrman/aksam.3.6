{% extends 'admin/base.html.twig' %}

{% block title %}Éditer {{ user.username }}{% endblock %}

{% block body %}
    {{ include('admin/_header.html.twig', {
        title: 'Éditer ' ~ user.username,
        description: 'Modifier le compte utilisateur'
    }) }}

    <div class="mt-4 md:mt-5">
        {{ form_start(form) }}
            {{ include('user/_form_fields.html.twig', { form: form }) }}
            {{ form_rest(form) }}
            <button type="submit" class="mt-4 inline-flex items-center gap-1.5 rounded-lg bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground transition-all hover:scale-[1.02] hover:opacity-90 hover:shadow-lg hover:shadow-primary/30">
                Enregistrer
            </button>
        {{ form_end(form, { render_rest: false }) }}
    </div>
{% endblock %}
