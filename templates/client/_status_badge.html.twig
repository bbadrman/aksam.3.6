{% set badge_class = {
    1: 'border-emerald-500/30 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400',
    2: 'border-destructive/30 bg-destructive/10 text-destructive',
    3: 'border-border bg-secondary text-muted-foreground',
}[client.status] ?? 'border-amber-500/30 bg-amber-500/10 text-amber-600 dark:text-amber-400' %}
<span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium {{ badge_class }}">{{ client.statusLabel }}</span>
