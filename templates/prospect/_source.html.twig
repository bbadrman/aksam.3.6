{% set motifs = {
    1: 'Parrainage',
    2: 'Appel Entrant',
    3: 'Avenant',
    4: 'Ancienne Contrat',
    5: 'Propre site',
    6: 'Revendeur',
    7: 'Hors cible',
    8: 'Test',
    9: 'Ancienne fiche',
} %}
{% set badge = 'inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium' %}

{% if prospect.source == 3 %}
    {% if prospect.url is null %}
        <span class="{{ badge }} bg-secondary text-muted-foreground">Autre Site</span>
    {% elseif sites[prospect.url] is defined %}
        {% set site = sites[prospect.url] %}
        <a href="{{ site[1] }}" target="_blank" rel="noopener" title="{{ site[1] }}" class="font-medium text-primary hover:underline">{{ site[0] }}</a>
    {% endif %}
{% elseif prospect.source == 2 %}
    <span class="{{ badge }} bg-sky-500/15 text-sky-600 dark:text-sky-400">Revendeur</span>
{% elseif prospect.source == 4 %}
    <span class="{{ badge }} bg-orange-500/15 text-orange-600 dark:text-orange-400">ADKOMO</span>
{% elseif prospect.source == 1 %}
    {% if prospect.motifSaisi is null %}
        <span class="{{ badge }} bg-emerald-500/15 text-emerald-600 dark:text-emerald-400">LEADS</span>
    {% elseif motifs[prospect.motifSaisi] is defined %}
        <span class="{{ badge }} bg-secondary text-muted-foreground">{{ motifs[prospect.motifSaisi] }}</span>
    {% endif %}
{% else %}
    —
{% endif %}
