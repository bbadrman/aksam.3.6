{% extends 'admin/base.html.twig' %}

{% block title %}Éditer {{ team.nom }}{% endblock %}

{% block body %}
    {{ include('admin/_header.html.twig', {
        title: 'Éditer ' ~ team.nom,
        description: 'Modifier l\'équipe'
    }) }}

    <div class="mt-4 rounded-2xl border border-border bg-card p-5 shadow-sm md:mt-5">
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button type="submit" class="mt-4 inline-flex items-center gap-1.5 rounded-lg bg-primary px-3 py-2 text-sm font-medium text-primary-foreground transition-all hover:opacity-90">
                Enregistrer
            </button>
        {{ form_end(form) }}
    </div>
{% endblock %}
