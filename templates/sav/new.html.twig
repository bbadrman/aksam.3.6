{% extends 'base.html.twig' %}

{% block body %}
    <h1>Nouveau SAV — Contrat {{ contrat.numeroPolice ?? ('#' ~ contrat.id) }}</h1>
    <form method="post">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <label>Nature de la demande</label>
        <input type="text" name="natureDemande">
        <label>Motif</label>
        <textarea name="motif"></textarea>
        <label>Montant</label>
        <input type="text" name="montant">
        <button type="submit">Ouvrir le SAV</button>
    </form>
{% endblock %}
