{% extends 'admin/base.html.twig' %}

{% block title %}Contrats{% endblock %}

{% block body %}
    {% set actions %}
        <a href="{{ path('app_contrat_new') }}" class="flex h-9 w-full items-center justify-center rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground transition-all duration-300 hover:scale-105 hover:bg-primary/90 hover:shadow-lg hover:shadow-primary/30 sm:w-auto">
            Nouveau contrat
        </a>
    {% endset %}
    {{ include('admin/_header.html.twig', {
        title: 'Contrats',
        description: 'Liste des contrats',
        actions: actions
    }) }}

    <div class="mt-4 overflow-x-auto rounded-2xl border border-border bg-card shadow-sm md:mt-5">
        <table class="w-full text-left text-sm">
            <thead>
                <tr class="border-b border-border text-xs uppercase tracking-wider text-muted-foreground">
                    <th class="px-4 py-3 font-medium">Client</th>
                    <th class="px-4 py-3 font-medium">Produit</th>
                    <th class="px-4 py-3 font-medium">Statut</th>
                    <th class="px-4 py-3 font-medium">N° police</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-border">
                {% for contrat in contrats %}
                    <tr class="transition-colors hover:bg-secondary/50">
                        <td class="px-4 py-3 font-medium text-foreground">
                            <a href="{{ path('app_contrat_show', {id: contrat.id}) }}" class="hover:text-primary hover:underline">{{ contrat.client.displayName }}</a>
                        </td>
                        <td class="px-4 py-3 text-muted-foreground">{{ contrat.product.nom }}</td>
                        <td class="px-4 py-3">
                            <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium {{ contrat.statut.value == 'valide' ? 'bg-primary/10 text-primary' : (contrat.statut.value == 'resilie' ? 'bg-destructive/10 text-destructive' : 'bg-secondary text-muted-foreground') }}">
                                {{ contrat.statut.label }}
                            </span>
                        </td>
                        <td class="px-4 py-3 text-muted-foreground">{{ contrat.numeroPolice ?? '—' }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="px-4 py-6 text-center text-muted-foreground">Aucun contrat.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
