{# expects: title, description, and optional variable "actions" (raw HTML) #}
<header class="animate-admin-slide-in-up space-y-3 md:space-y-4">
    <div class="flex items-center justify-between gap-3">
        <div class="flex flex-1 items-center gap-2">
            <button type="button" class="rounded-lg p-2 text-foreground hover:bg-secondary lg:hidden" data-action="admin-sidebar#open">
                {{ include('admin/_icon.html.twig', { name: 'menu', class: 'h-6 w-6' }) }}
            </button>
        </div>

        <div class="flex items-center gap-1.5 md:gap-2">
            <button type="button" data-controller="admin-theme" data-action="click->admin-theme#toggle"
                    class="flex h-8 w-8 items-center justify-center rounded-lg text-foreground transition-all duration-300 hover:scale-110 hover:bg-secondary"
                    aria-label="Basculer le mode sombre">
                <span data-admin-theme-target="sun">{{ include('admin/_icon.html.twig', { name: 'sun' }) }}</span>
                <span data-admin-theme-target="moon" class="hidden">{{ include('admin/_icon.html.twig', { name: 'moon' }) }}</span>
            </button>

            {% if app.user %}
                <div class="flex items-center gap-2 border-l border-border pl-2 md:pl-3">
                    <div class="flex h-7 w-7 items-center justify-center rounded-full bg-primary text-xs font-semibold text-primary-foreground ring-2 ring-primary/20 md:h-8 md:w-8">
                        {{ app.user.username|slice(0, 2)|upper }}
                    </div>
                    <div class="hidden text-xs sm:block">
                        <p class="font-semibold text-foreground">{{ app.user.username }}</p>
                        <p class="text-[10px] text-muted-foreground">{{ app.user.roles|join(', ') }}</p>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

    <div>
        <h1 class="mb-1 text-xl font-bold text-foreground md:text-2xl lg:text-3xl">{{ title }}</h1>
        {% if description is defined and description %}
            <p class="text-xs text-muted-foreground md:text-sm">{{ description }}</p>
        {% endif %}
    </div>

    {% if actions is defined and actions %}
        <div class="flex flex-col gap-2 sm:flex-row">
            {{ actions|raw }}
        </div>
    {% endif %}
</header>
