{% set menu_items = [
    { icon: 'dashboard', label: 'Tableau de bord', href: path('app_home'), route: 'app_home' },
    { icon: 'tasks', label: 'Nouveaux prospects', href: path('app_traitement_nouveaux'), route: 'app_traitement_nouveaux' },
    { icon: 'alert-circle', label: 'Non traités', href: path('app_traitement_non_traites'), route: 'app_traitement_non_traites' },
    { icon: 'calendar', label: 'Relances du jour', href: path('app_traitement_relances_du_jour'), route: 'app_traitement_relances_du_jour' },
    { icon: 'trending-up', label: 'Relances à venir', href: path('app_traitement_relances_a_venir'), route: 'app_traitement_relances_a_venir' },
    { icon: 'x-circle', label: 'Injoignables', href: path('app_traitement_injoignables'), route: 'app_traitement_injoignables' },
    { icon: 'team', label: 'Clients', href: path('app_client_index'), route: 'app_client_index' },
    { icon: 'receipt', label: 'Contrats', href: path('app_contrat_index'), route: 'app_contrat_index' },
    { icon: 'truck', label: 'SAV', href: path('app_sav_index'), route: 'app_sav_index' },
] %}
{% set general_items = [
    { icon: 'logout', label: 'Déconnexion', href: path('app_logout'), route: 'app_logout' },
] %}

<aside id="admin-sidebar" class="fixed top-0 left-0 z-50 w-64 h-screen -translate-x-full overflow-y-auto border-r border-border bg-card p-4 transition-transform duration-300 lg:translate-x-0" data-admin-sidebar-target="panel">
    <div class="mb-6 flex items-center gap-2">
        <a href="{{ path('app_home') }}" class="flex items-center gap-2">
            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-semibold text-primary-foreground">A</div>
            <span class="text-lg font-semibold text-foreground">AksamCrm</span>
        </a>
        <button type="button" class="ml-auto rounded-lg p-1.5 text-muted-foreground hover:bg-secondary lg:hidden" data-action="admin-sidebar#close">
            ✕
        </button>
    </div>

    <div class="space-y-4">
        <div>
            <p class="mb-2 text-[10px] font-medium uppercase tracking-wider text-muted-foreground">Menu</p>
            <nav class="space-y-0.5">
                {% for item in menu_items %}
                    <a href="{{ item.href }}"
                       class="flex w-full items-center gap-2.5 rounded-lg px-2.5 py-2 text-sm font-medium transition-all duration-300 {{ app.request.attributes.get('_route') == item.route ? 'bg-primary text-primary-foreground shadow-lg shadow-primary/20' : 'text-muted-foreground hover:translate-x-1 hover:bg-secondary hover:text-foreground' }}">
                        {{ include('admin/_icon.html.twig', { name: item.icon }) }}
                        <span>{{ item.label }}</span>
                    </a>
                {% endfor %}
            </nav>
        </div>

        <div>
            <p class="mb-2 text-[10px] font-medium uppercase tracking-wider text-muted-foreground">Général</p>
            <nav class="space-y-0.5">
                {% for item in general_items %}
                    <a href="{{ item.href }}"
                       class="flex w-full items-center gap-2.5 rounded-lg px-2.5 py-2 text-sm font-medium transition-all duration-300 text-muted-foreground hover:translate-x-1 hover:bg-secondary hover:text-foreground">
                        {{ include('admin/_icon.html.twig', { name: item.icon }) }}
                        <span>{{ item.label }}</span>
                    </a>
                {% endfor %}
            </nav>
        </div>
    </div>
</aside>
