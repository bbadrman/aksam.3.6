{% set menu_items = [
    { icon: 'dashboard', label: 'Tableau de bord', href: path('app_home'), route: 'app_home' },
    { icon: 'tasks', label: 'Nouveaux prospects', href: path('app_traitement_nouveaux'), route: 'app_traitement_nouveaux', count: traitement_count('nouveaux'), permission: 'PERM_NOUVEAU_PROSPECT' },
    { icon: 'tasks', label: 'Mes nouveaux prospects', href: path('app_traitement_mes_nouveaux'), route: 'app_traitement_mes_nouveaux', count: traitement_count('mes_nouveaux'), permission: 'PERM_MES_NOUVEAUX_PROSPECTS' },
    { icon: 'alert-circle', label: 'Non traités', href: path('app_traitement_non_traites'), route: 'app_traitement_non_traites', count: traitement_count('non_traites'), permission: 'PERM_PROSPECTS_NON_TRAITES' },
    { icon: 'calendar', label: 'Relances du jour', href: path('app_traitement_relances_du_jour'), route: 'app_traitement_relances_du_jour', count: traitement_count('relances_du_jour'), permission: 'PERM_RELANCES_DU_JOUR' },
    { icon: 'trending-up', label: 'Relances à venir', href: path('app_traitement_relances_a_venir'), route: 'app_traitement_relances_a_venir', count: traitement_count('relances_a_venir'), permission: 'PERM_RELANCES_A_VENIR' },
    { icon: 'alert-circle', label: 'Relances non traitées', href: path('app_traitement_relances_non_traitees'), route: 'app_traitement_relances_non_traitees', count: traitement_count('relances_non_traitees'), permission: 'PERM_RELANCES_NON_TRAITEES' },
    { icon: 'x-circle', label: 'Injoignables', href: path('app_traitement_injoignables'), route: 'app_traitement_injoignables', count: traitement_count('injoignables'), permission: 'PERM_INJOIGNABLES' },
    { icon: 'team', label: 'Clients', href: path('app_client_index'), route: 'app_client_index' },
    { icon: 'receipt', label: 'Contrats', href: path('app_contrat_index'), route: 'app_contrat_index' },
    { icon: 'truck', label: 'SAV', href: path('app_sav_index'), route: 'app_sav_index', permission: 'PERM_SAV_OUVERTS' },
] %}
{% set menu_items = menu_items|filter(item => item.permission is not defined or is_granted(item.permission)) %}
{% set general_items = [] %}
{% if is_granted('ROLE_ADMIN') %}
    {% set general_items = general_items|merge([
        { icon: 'settings', label: 'Utilisateurs', href: path('app_user_index'), route: 'app_user_index' },
        { icon: 'team', label: 'Équipes', href: path('app_team_index'), route: 'app_team_index' },
        { icon: 'receipt', label: 'Produits', href: path('app_product_index'), route: 'app_product_index' },
        { icon: 'analytics', label: 'Distribution', href: path('app_distribution_dashboard'), route: 'app_distribution_dashboard' },
    ]) %}
{% endif %}
{% set general_items = general_items|merge([
    { icon: 'logout', label: 'Déconnexion', href: path('app_logout'), route: 'app_logout' },
]) %}

<aside id="admin-sidebar" class="fixed top-0 left-0 z-50 w-64 h-screen -translate-x-full overflow-y-auto border-r border-border bg-card p-4 transition-transform duration-300 lg:translate-x-0" data-admin-sidebar-target="panel">
    <div class="mb-6 flex items-start gap-2">
        <a href="{{ path('app_home') }}" class="flex flex-1 flex-col items-center gap-1">
            <img src="{{ asset('images/logo.png') }}" alt="Aksam" class="h-16 w-auto object-contain">
            <span class="text-sm font-semibold text-foreground">Aksam v3.0.1</span>
        </a>
        <button type="button" class="rounded-lg p-1.5 text-muted-foreground hover:bg-secondary lg:hidden" data-action="admin-sidebar#close">
            ✕
        </button>
    </div>

    <div class="space-y-4">
        <div>
            <p class="mb-2 text-[10px] font-medium uppercase tracking-wider text-muted-foreground">Menu</p>
            <nav class="space-y-0.5">
                {% for item in menu_items %}
                    <a href="{{ item.href }}"
                       class="flex w-full items-center gap-2.5 rounded-lg px-2.5 py-2 text-sm font-medium transition-all duration-300 {{ app.request.attributes.get('_route') == item.route ? 'bg-primary text-primary-foreground shadow-lg shadow-primary/20' : 'text-foreground hover:translate-x-1 hover:bg-secondary hover:text-foreground' }}">
                        {{ include('admin/_icon.html.twig', { name: item.icon }) }}
                        <span class="flex-1">{{ item.label }}</span>
                        {% if item.count is defined and item.count > 0 %}
                            <span class="rounded-full bg-primary/10 px-2 py-0.5 text-xs font-semibold text-primary {{ app.request.attributes.get('_route') == item.route ? 'bg-primary-foreground/20 text-primary-foreground' : '' }}">{{ item.count }}</span>
                        {% endif %}
                    </a>
                {% endfor %}
            </nav>
        </div>

        <div>
            <p class="mb-2 text-[10px] font-medium uppercase tracking-wider text-muted-foreground">Général</p>
            <nav class="space-y-0.5">
                {% for item in general_items %}
                    <a href="{{ item.href }}"
                       class="flex w-full items-center gap-2.5 rounded-lg px-2.5 py-2 text-sm font-medium transition-all duration-300 text-muted-foreground hover:translate-x-1 hover:bg-secondary hover:text-foreground">
                        {{ include('admin/_icon.html.twig', { name: item.icon }) }}
                        <span>{{ item.label }}</span>
                    </a>
                {% endfor %}
            </nav>
        </div>
    </div>
</aside>
